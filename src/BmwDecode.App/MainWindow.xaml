<Window x:Class="BmwDecode.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BmwDecode.App.ViewModels"
        xmlns:views="clr-namespace:BmwDecode.App.Views"
        Title="bmwDecode – BMW E-series diagnostics"
        Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehicleViewModel}"><views:VehicleView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickTestViewModel}"><views:QuickTestView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModulesViewModel}"><views:ModulesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobExplorerViewModel}"><views:JobExplorerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}"><views:LogView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

        <DataTemplate x:Key="NavItem" DataType="{x:Type vm:PageViewModel}">
            <StackPanel Orientation="Horizontal" Margin="4,6">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation pane -->
        <Grid Grid.Column="0" Margin="8,12,4,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="12,4,12,16">
                <TextBlock Text="bmwDecode" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="E-series diagnostics" Style="{StaticResource Caption}" />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                     ItemTemplate="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <ListBox Grid.Row="2" ItemsSource="{Binding FooterPages}" SelectedItem="{Binding SelectedFooterPage, Mode=TwoWay}"
                     ItemTemplate="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Margin="0,8,0,8" />

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                    </StackPanel>
                    <TextBlock Text="DEMO MODE – simulated vehicle" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="16,4,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="4,8,8,0" CornerRadius="8,8,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0">
                <ContentControl Content="{Binding Navigator.Current}" Focusable="False" Margin="28,20,28,12" />
            </Border>

            <Border Grid.Row="1" Margin="4,0,8,8" Padding="16,6" CornerRadius="0,0,8,8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="{Binding VehicleText}" Style="{StaticResource Caption}" />
            </Border>
        </Grid>
    </Grid>
</Window>
