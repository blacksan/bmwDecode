<UserControl x:Class="BmwDecode.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Log" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Every connection, identification and job of this session. Attach it when asking for help." Style="{StaticResource PageSubtitle}" Margin="0,0,0,12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Copy" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
            <Button Content="Save…" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,16,0" />
            <CheckBox Content="Show job details (debug)" IsChecked="{Binding ShowDebug}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding EntriesView}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" EnableRowVirtualization="True" RowHeight="26">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat='HH:mm:ss.fff'}" Width="100" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
