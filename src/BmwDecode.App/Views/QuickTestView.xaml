<UserControl x:Class="BmwDecode.App.Views.QuickTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Quick test" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,16">
                <Run Text="Identifies every module of the" />
                <Run Text="{Binding SeriesName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="profile and reads its fault memory. Double-click a module to open it." />
            </TextBlock>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding RunCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsWorking, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RunCancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearAllCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Clear all faults" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportHtmlCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Report" />
                    </StackPanel>
                </Button>
                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,16,0" />
                <CheckBox Content="Read identification" IsChecked="{Binding ReadIdent}" VerticalAlignment="Center" Margin="0,0,16,0"
                          IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}" />
                <CheckBox Content="Show modules that did not answer" IsChecked="{Binding ShowAll}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Progress + summary -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ProgressBar Maximum="{Binding Total}" Value="{Binding Done}" Height="4" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Current, TargetNullValue={x:Null}}" Style="{StaticResource Caption}"
                               Visibility="{Binding Current, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Found}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="modules" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FaultTotal}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="faults" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="24,0,8,0" HorizontalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding Done, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Total, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="scanned" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" SelectionMode="Single" RowHeight="36">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenModuleCommand}" CommandParameter="{Binding SelectedRow}" />
                <KeyBinding Key="Enter" Command="{Binding OpenModuleCommand}" CommandParameter="{Binding SelectedRow}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource ScanStateToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Addr" Binding="{Binding Ecu.AddressHex}" Width="64" />
                <DataGridTextColumn Header="Module" Binding="{Binding Ecu.Abbreviation}" Width="100" />
                <DataGridTextColumn Header="Description" Binding="{Binding Ecu.Description}" Width="2*" />
                <DataGridTextColumn Header="SGBD" Binding="{Binding Variant}" Width="*" />
                <DataGridTextColumn Header="Part no." Binding="{Binding PartNumber}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Margin="0,8,0,0"
                   Text="Clearing faults: ignition on, engine off. Present faults come straight back – fix the cause first. Coding and programming are not part of bmwDecode." />
    </Grid>
</UserControl>
