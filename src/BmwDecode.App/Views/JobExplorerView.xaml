<UserControl x:Class="BmwDecode.App.Views.JobExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="5" Margin="0,0,0,12">
            <TextBlock Text="Job explorer" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- SGBD files -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter SGBD files (e.g. D60, CAS, DSC)" />
            <ListBox ItemsSource="{Binding FilesView}" SelectedItem="{Binding SelectedFile}" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                            <TextBlock Text="  group" Style="{StaticResource Caption}" VerticalAlignment="Center">
                                <TextBlock.Visibility>
                                    <Binding Path="IsGroup" Converter="{StaticResource BoolToVisibility}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Jobs -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{Binding LoadedName, TargetNullValue='No SGBD loaded'}" Style="{StaticResource SectionTitle}" FontSize="14" />
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding JobFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter jobs by name or comment" />
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
            <ListBox ItemsSource="{Binding JobsView}" SelectedItem="{Binding SelectedJob}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                            <TextBlock Text="{Binding Comment}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="250" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Job details + run -->
        <Grid Grid.Row="1" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedJob.Name, TargetNullValue='Select a job'}" Style="{StaticResource SectionTitle}" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Text="{Binding JobDetails.Comment}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding JobDetails.Arguments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,1">
                                    <Run Text="arg" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Type, Mode=OneWay, StringFormat='({0})'}" />
                                    <Run Text="{Binding Comment, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Results this job returns" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding JobDetails.Results}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,1">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Type, Mode=OneWay, StringFormat='({0})'}" />
                                        <Run Text="{Binding Comment, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyResultsCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding RunCancelCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding RunCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Run job" />
                    </StackPanel>
                </Button>
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                         ToolTip="Arguments, separated by ';' (e.g. 0x4B93 or 1;2)" />
            </DockPanel>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ResultSummary}" Style="{StaticResource Caption}" Margin="0,0,0,6"
                           Visibility="{Binding ResultSummary, Converter={StaticResource NullToVisibility}}" />
                <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Set" Binding="{Binding Set}" Width="44" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Name}" Width="*" FontFamily="Cascadia Mono, Consolas" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
