<UserControl x:Class="BmwDecode.App.Views.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Vehicle / VIN" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,16"
                       Text="Identify any BMW from its VIN – the full 17 characters or the last 7, like RealOEM. Works offline; connect the car for the vehicle order, build date, options and engine ECU." />

            <!-- Input -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding DecodeCommand}" Margin="8,0,0,0" MinWidth="100">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Decode" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding VinInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="16"
                                 CharacterCasing="Upper" MaxLength="24" ToolTip="17-character VIN or 7-character short VIN">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding DecodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Command="{Binding OpenRealOemCommand}" Margin="0,0,8,0" ToolTip="Opens RealOEM with the short VIN in your browser">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Open in RealOEM" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OnlineCommand}" Margin="0,0,8,0" ToolTip="Free decode by the US NHTSA vPIC service (best for US-market cars)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Online decode (NHTSA)" />
                            </StackPanel>
                        </Button>
                        <Button Content="Copy short VIN" Command="{Binding CopyShortVinCommand}" Margin="0,0,8,0" />
                        <Button Command="{Binding UseSeriesCommand}" ToolTip="Use this chassis as the diagnosis profile">
                            <TextBlock Text="{Binding DecodedSeries.Series, StringFormat='Use {0} profile', TargetNullValue='Use profile'}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ErrorBar}" Visibility="{Binding Problems, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Problems}" Style="{StaticResource Value}" />
            </Border>

            <TextBlock Text="{Binding Headline}" Style="{StaticResource SectionTitle}" FontSize="22" Margin="0,4,0,12"
                       Visibility="{Binding Headline, Converter={StaticResource NullToVisibility}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Model -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Vehicle" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ModelRows}" ItemTemplate="{StaticResource KeyValueRow}" />
                        <TextBlock Text="No model data yet – connect the car or extend the type key list." Style="{StaticResource Caption}"
                                   Visibility="{Binding ModelRows.Count, Converter={StaticResource ZeroToVisibility}}" />

                        <TextBlock Text="Options (SA codes)" FontSize="14" Margin="0,14,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Options.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- VIN structure -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="VIN structure" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding VinRows}" ItemTemplate="{StaticResource KeyValueRow}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Online -->
            <Border Style="{StaticResource Card}" Visibility="{Binding OnlineMessage, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding OnlineCancelCommand}" />
                        <TextBlock Text="Online decode" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="{Binding OnlineMessage}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OnlineRows}" ItemTemplate="{StaticResource KeyValueRow}" />
                </StackPanel>
            </Border>

            <!-- Evidence -->
            <Border Style="{StaticResource InfoBar}">
                <StackPanel>
                    <TextBlock Text="Where this comes from" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TypeKeyInfo}" Style="{StaticResource Caption}" Margin="0,6,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Edit type key list…" Command="{Binding OpenTypeKeyFileCommand}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding TypeKeyCsvPath}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
