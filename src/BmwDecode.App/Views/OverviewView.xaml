<UserControl x:Class="BmwDecode.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Connect your K+DCAN cable, switch the ignition on (engine off) and connect. bmwDecode identifies the car and reads every module, like INPA's quick test."
                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,20" />

            <Border Style="{StaticResource ErrorBar}" Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA39;" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Value}" />
                </DockPanel>
            </Border>

            <!-- Connection -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE703;" Margin="0,0,10,0" FontSize="20" />
                        <TextBlock Text="{Binding ConnectionTitle}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0" IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Interface" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding NeedsPort, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PortLabel}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Ports}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Bottom" Command="{Binding RefreshPortsCommand}"
                                ToolTip="Refresh port list" Visibility="{Binding NeedsPort, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <Button Content="Connect" Style="{DynamicResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0"
                                Command="{Binding ConnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="Cancel" Command="{Binding ConnectCancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" MinWidth="110"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SelectedInterface.Hint}" Style="{StaticResource Caption}" Margin="0,10,0,0" />

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Text="&#xE8B7;" />
                        <TextBlock Text="{Binding EcuPathText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,0,0,12"
                       Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />

            <!-- Vehicle -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Identify again" Command="{Binding IdentifyCommand}" Margin="0,0,8,0" />
                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding QuickTestCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="Run quick test" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE804;" Margin="0,0,10,0" FontSize="20" />
                            <TextBlock Text="Vehicle" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Value}">
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Chassis profile" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <ComboBox ItemsSource="{Binding SeriesOptions}" SelectedItem="{Binding SelectedSeries}"
                                      DisplayMemberPath="DisplayName" MinWidth="260" />
                            <TextBlock Text="{Binding SelectedSeries.Family, StringFormat='family {0}'}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="VIN" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Vehicle.Vin, Mode=OneWay, TargetNullValue='—'}" IsReadOnly="True"
                                 FontFamily="Cascadia Mono, Consolas" BorderThickness="0" Background="Transparent" Margin="0,2" />

                        <TextBlock Grid.Row="2" Text="Series reported" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vehicle.Series, TargetNullValue='—'}" />

                        <TextBlock Grid.Row="3" Text="Read from" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Vehicle.VinSource, TargetNullValue='—'}" />

                        <TextBlock Grid.Row="4" Text="Battery" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Supply.BatteryText, TargetNullValue='—'}" />

                        <TextBlock Grid.Row="5" Text="Ignition" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Supply.IgnitionText, TargetNullValue='—'}" />
                    </Grid>

                    <Border Style="{StaticResource WarningBar}" Margin="0,12,0,0"
                            Visibility="{Binding SeriesMismatch, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding SeriesMismatch}" Style="{StaticResource Value}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBar}">
                <StackPanel>
                    <TextBlock Text="Cable checklist" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="• E8x / E9x / E84 use D-CAN: set the cable switch to D-CAN (pins 7 and 8 not bridged). Older cars (E46, E39, E53) need K-line.&#x0a;• Device Manager → Ports → USB Serial Port → Advanced: latency timer 1 ms, and note the COM number (any number works – unlike INPA it need not be COM1).&#x0a;• Keep a battery charger on for long sessions; diagnostics with the ignition on drains the battery." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
