<UserControl x:Class="BmwDecode.App.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="Modules" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Hint}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Module list -->
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,10,0" Fill="{Binding State, Converter={StaticResource ScanStateToBrush}}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Caption, Mode=OneWay}" />
                                <Run Text="{Binding Ecu.AddressHex, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="Normal" FontSize="12" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="9" MinWidth="18" Padding="6,1" VerticalAlignment="Center"
                                Background="{DynamicResource SystemFillColorCriticalBrush}"
                                Visibility="{Binding Badge, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="Select a module on the left.">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Module}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Module detail -->
        <Grid Grid.Row="1" Grid.Column="2" DataContext="{Binding Module}"
              Visibility="{Binding Converter={StaticResource NullToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding RefreshAllCommand}" ToolTip="Read identification, fault and info memory">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Read all" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <TabControl Grid.Row="2">
                <!-- Faults -->
                <TabItem Header="Fault memory">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Read" Command="{Binding ReadFaultsCommand}" Margin="0,0,8,0" />
                            <Button Content="Clear fault memory" Command="{Binding ClearFaultsCommand}" />
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Faults}" SelectedItem="{Binding SelectedFault}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="28">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsPresent, Converter={StaticResource ScanStateToBrush}}"
                                                     ToolTip="Red: currently present · grey: stored only" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Code" Binding="{Binding CodeHex}" Width="70" FontFamily="Cascadia Mono, Consolas" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Text}" Width="3*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Symptom}" Width="1.5*" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Frequency}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="No faults stored." Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Faults.Count, Converter={StaticResource ZeroToVisibility}}" />

                        <!-- Freeze frame -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedFault.Text, TargetNullValue='Select a fault to see its environmental conditions'}" Style="{StaticResource SectionTitle}" FontSize="14" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6">
                                        <Run Text="{Binding SelectedFault.PresentText, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding SelectedFault.WarningText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DetailSummary}" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                               Visibility="{Binding DetailSummary, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding DetailConditions}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Condition" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Identification -->
                <TabItem Header="Identification">
                    <DataGrid Margin="0,12,0,0" ItemsSource="{Binding Ident}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Key}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Info memory -->
                <TabItem Header="Info memory">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Read" Command="{Binding ReadInfoCommand}" Margin="0,0,8,0" />
                            <Button Content="Clear info memory" Command="{Binding ClearInfoCommand}" />
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding InfoEntries}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding CodeHex}" Width="70" FontFamily="Cascadia Mono, Consolas" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Text}" Width="3*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Symptom}" Width="1.5*" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Frequency}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1" Text="Info memory is empty or not supported by this module." Style="{StaticResource PageSubtitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding InfoEntries.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </Grid>
                </TabItem>

                <!-- Live data -->
                <TabItem Header="Live data">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Load jobs" Command="{Binding LoadLiveJobsCommand}" Margin="0,0,8,0" />
                            <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding StartLiveCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsLive, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartLiveCancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                            <Button Content="Untick all" Command="{Binding ClearLiveSelectionCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding LiveStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding LiveJobs}" IsEnabled="{Binding IsLive, Converter={StaticResource InverseBool}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Comment}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="{Binding Comment}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="220" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DataGrid Grid.Row="1" Grid.Column="2" ItemsSource="{Binding LiveRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value" Binding="{Binding Label}" Width="2*" />
                                <DataGridTemplateColumn Header="Reading" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <Run Text="{Binding Value, Mode=OneWay}" />
                                                <Run Text="{Binding Unit, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="70" />
                                <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="70" />
                                <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
