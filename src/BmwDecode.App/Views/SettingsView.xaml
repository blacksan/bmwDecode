<UserControl x:Class="BmwDecode.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Changes are saved automatically." Style="{StaticResource PageSubtitle}" Margin="0,0,0,20" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="EDIABAS ECU folder" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="The SGBD files (*.prg, *.grp) from your INPA / EDIABAS install, normally C:\EDIABAS\Ecu. bmwDecode runs them with its own EDIABAS engine – BMW's EDIABAS does not need to be configured, and no BMW files are bundled with the app." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Detect" Command="{Binding DetectCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding EcuPath, UpdateSourceTrigger=LostFocus}" FontFamily="Cascadia Mono, Consolas" />
                    </DockPanel>
                    <TextBlock Text="{Binding EcuStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Preferences" Style="{StaticResource SectionTitle}" />

                    <TextBlock Grid.Row="1" Text="Theme" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="200" HorizontalAlignment="Left" Margin="0,4" />

                    <TextBlock Grid.Row="2" Text="Default chassis profile" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SeriesOptions}" SelectedItem="{Binding DefaultSeries}" Width="200" HorizontalAlignment="Left" Margin="0,4" />

                    <TextBlock Grid.Row="3" Text="Live data interval (ms)" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LiveIntervalMs, UpdateSourceTrigger=LostFocus}" Width="200" HorizontalAlignment="Left" Margin="0,4" />

                    <TextBlock Grid.Row="4" Text="EDIABAS interface trace" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding EdiabasTrace}" Margin="0,4"
                              Content="Write ifh.trc / api.trc to %TEMP%\bmwDecode\trace (applies on next connect)" />

                    <TextBlock Grid.Row="5" Text="Translate German texts" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding TranslateTexts}" Margin="0,4"
                              Content="Show fault texts, conditions and job descriptions in English (applies to newly read data)" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TranslationInfo}" Style="{StaticResource Caption}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="7" Text="Scan on connect" Style="{StaticResource Value}" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding AutoScan}" Margin="0,4"
                              Content="Identify the car from its VIN and list the modules it reports straight after connecting" />

                    <TextBlock Grid.Row="8" Text="ISTA history" Style="{StaticResource Value}" VerticalAlignment="Top" Margin="0,4" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding IstaInfo}" Style="{StaticResource Caption}" Margin="0,4" />

                    <TextBlock Grid.Row="9" Text="Built-in data" Style="{StaticResource Value}" VerticalAlignment="Top" Margin="0,4" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DataPackInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Value}">
                        <Run Text="bmwDecode" FontWeight="SemiBold" />
                        <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Free software under the GNU GPL v3. Diagnostics run on EdiabasLib by Ulrich Holeschak (GPLv3), and the chassis catalogue comes from the same project. BMW, INPA, EDIABAS and ISTA are trademarks of BMW AG; this project is not affiliated with BMW." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Use at your own risk. Clearing fault memory and running writing jobs can change vehicle behaviour; keep a charger connected and know what a job does before you run it." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                        <TextBlock Text="{Binding SettingsFolder}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
