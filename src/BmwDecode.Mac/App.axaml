<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:BmwDecode.Mac"
             x:Class="BmwDecode.Mac.App"
             Name="bmwDecode"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="PageBrush" Color="#FFF6F6F6" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF0F7B0F" />
                    <SolidColorBrush x:Key="CriticalBrush" Color="#FFC42B1C" />
                    <SolidColorBrush x:Key="CautionBrush" Color="#FF9D5D00" />
                    <SolidColorBrush x:Key="NeutralBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF005FB8" />
                    <SolidColorBrush x:Key="ErrorBarBrush" Color="#FFFDE7E9" />
                    <SolidColorBrush x:Key="WarningBarBrush" Color="#FFFFF4CE" />
                    <SolidColorBrush x:Key="InfoBarBrush" Color="#FFE8F1FB" />
                    <SolidColorBrush x:Key="ChipBrush" Color="#0A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBrush" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#19FFFFFF" />
                    <SolidColorBrush x:Key="PageBrush" Color="#FF202020" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
                    <SolidColorBrush x:Key="CriticalBrush" Color="#FFFF99A4" />
                    <SolidColorBrush x:Key="CautionBrush" Color="#FFFCE100" />
                    <SolidColorBrush x:Key="NeutralBrush" Color="#8BFFFFFF" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF99EBFF" />
                    <SolidColorBrush x:Key="ErrorBarBrush" Color="#FF442726" />
                    <SolidColorBrush x:Key="WarningBarBrush" Color="#FF433519" />
                    <SolidColorBrush x:Key="InfoBarBrush" Color="#FF27323C" />
                    <SolidColorBrush x:Key="ChipBrush" Color="#0FFFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <local:ScanStateToBrushConverter x:Key="ScanStateToBrush" />
            <local:ZeroToTrueConverter x:Key="IsZero" />
            <local:ZeroToTrueConverter x:Key="IsNonZero" Invert="True" />
            <local:PageIconConverter x:Key="PageIcon" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://bmwDecode/Styles.axaml" />
    </Application.Styles>
</Application>
