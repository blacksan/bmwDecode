<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BmwDecode.Mac.Views.VehicleView">
    <UserControl.Resources>
        <DataTemplate x:Key="KeyValueRow">
            <Grid ColumnDefinitions="180,*" Margin="0,3">
                <TextBlock Text="{Binding Key}" Classes="caption" FontSize="13" VerticalAlignment="Top" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Vehicle / VIN" Classes="pageTitle" />
            <TextBlock Classes="pageSubtitle" Margin="0,0,0,16"
                       Text="Identify any BMW from its VIN – the full 17 characters or the last 7, like RealOEM. Works offline; connect the car for the vehicle order, build date, options and engine ECU." />

            <Border Classes="card">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Decode" Classes="accent" Command="{Binding DecodeCommand}" Margin="8,0,0,0" MinWidth="100" />
                        <TextBox Text="{Binding VinInput}" Classes="mono" FontSize="16" MaxLength="24"
                                 Watermark="17-character VIN or 7-character short VIN">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding DecodeCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Open in RealOEM" Command="{Binding OpenRealOemCommand}" ToolTip.Tip="Opens RealOEM with the short VIN in your browser" />
                        <Button Content="Online decode (NHTSA)" Command="{Binding OnlineCommand}" ToolTip.Tip="Free decode by the US NHTSA vPIC service (best for US-market cars)" />
                        <Button Content="Copy short VIN" Command="{Binding CopyShortVinCommand}" />
                        <Button Command="{Binding UseSeriesCommand}" ToolTip.Tip="Use this chassis as the diagnosis profile">
                            <TextBlock Text="{Binding DecodedSeries.Series, StringFormat='Use {0} profile', TargetNullValue='Use profile'}" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="errorBar" IsVisible="{Binding Problems, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Problems}" Classes="value" />
            </Border>

            <TextBlock Text="{Binding Headline}" Classes="section" FontSize="22" Margin="0,4,0,12"
                       IsVisible="{Binding Headline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Grid ColumnDefinitions="*,12,*">
                <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Vehicle" Classes="section" />
                        <ItemsControl ItemsSource="{Binding ModelRows}" ItemTemplate="{StaticResource KeyValueRow}" />
                        <TextBlock Text="No model data yet – connect the car or extend the type key list." Classes="caption"
                                   IsVisible="{Binding ModelRows.Count, Converter={StaticResource IsZero}}" />
                        <TextBlock Text="Options (SA codes)" Classes="section" FontSize="14" Margin="0,14,0,6"
                                   IsVisible="{Binding Options.Count, Converter={StaticResource IsNonZero}}" />
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,6" Background="{DynamicResource ChipBrush}"
                                            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding}" Classes="mono" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="VIN structure" Classes="section" />
                        <ItemsControl ItemsSource="{Binding VinRows}" ItemTemplate="{StaticResource KeyValueRow}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" IsVisible="{Binding OnlineMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding OnlineCancelCommand}" Margin="0" />
                        <TextBlock Text="Online decode" Classes="section" />
                    </DockPanel>
                    <TextBlock Text="{Binding OnlineMessage}" Classes="caption" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OnlineRows}" ItemTemplate="{StaticResource KeyValueRow}" />
                </StackPanel>
            </Border>

            <Border Classes="infoBar">
                <StackPanel>
                    <TextBlock Text="Where this comes from" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Classes="caption" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TypeKeyInfo}" Classes="caption" Margin="0,6,0,6" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Edit type key list…" Command="{Binding OpenTypeKeyFileCommand}" Margin="0" />
                        <TextBlock Text="{Binding TypeKeyCsvPath}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
